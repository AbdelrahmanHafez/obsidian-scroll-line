{
	"name": "obsidian-scroll-line",
	"version": "1.0.0",
	"description": "Obsidian plugin to scroll the viewport by lines without moving the cursor",
	"main": "main.js",
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mts"
	},
	"keywords": ["obsidian", "plugin", "scroll"],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@types/node": "^22.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"typescript": "~5.6.0"
	}
}
